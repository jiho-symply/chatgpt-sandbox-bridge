# The directory ChatGPT is allowed to treat as its workspace.
# Point this at a directory INSIDE the environment you prepared.
CSB_WORKSPACE_ROOT=/path/to/workspace

# Persistent metadata and stdout/stderr logs.
CSB_STATE_DIR=/path/to/.chatgpt-sandbox-bridge

# Use externalSandbox when the current container/VM/WSL environment is already
# the isolation boundary you intentionally prepared for ChatGPT.
CSB_SANDBOX_MODE=externalSandbox
CSB_NETWORK=true

# process/spawn is not sandboxed by Codex. Enable this only when the current
# environment itself is safe for long-running arbitrary processes.
CSB_LONG_JOBS=true

# Optional for HTTP mode only. Stdio mode does not need it.
# CSB_BEARER_TOKEN=replace-with-a-long-random-secret

# Secure MCP Tunnel runtime credentials.
CONTROL_PLANE_TUNNEL_ID=tunnel_0123456789abcdef0123456789abcdef
CONTROL_PLANE_API_KEY=replace-with-runtime-api-key

# Recommended tunnel binding: tunnel-client launches this bridge over stdio.
MCP_COMMAND=chatgpt-sandbox-bridge --stdio
