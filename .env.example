# Linux/WSL host identity. Check with: id -u && id -g
CSB_UID=1000
CSB_GID=1000

# Generate a long random value. It authenticates tunnel-client -> bridge.
CSB_BEARER_TOKEN=replace-with-a-long-random-secret

# Secure MCP Tunnel runtime credentials from OpenAI Platform.
CONTROL_PLANE_TUNNEL_ID=tunnel_0123456789abcdef0123456789abcdef
CONTROL_PLANE_API_KEY=replace-with-runtime-api-key
